{
  "name": "smartresponsor/locator",
  "description": "Locator — utility engine for normalization, validation, and geocoding (DOM&DRIVE layer-first isolation).",
  "type": "library",
  "license": "proprietary",
  "autoload": {
    "psr-4": {
      "Smartresponsor\\": "src/"
    }
  },
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "symfony/config": "^7.2",
    "symfony/console": "^7.2",
    "symfony/dependency-injection": "^7.2",
    "symfony/http-foundation": "^7.2",
    "symfony/http-kernel": "^7.2",
    "symfony/routing": "^7.2"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.0"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "lint": "php -l src/Controller/Locator/StatusController.php",
    "stan": "php vendor/bin/phpstan analyse -c phpstan.neon",
    "test": "php vendor/bin/phpunit -c phpunit.xml.dist",
    "test:locator": "php vendor/bin/phpunit -c phpunit.xml.dist tests/Locator"
  }
}
