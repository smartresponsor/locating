<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="locator-unit">
            <directory suffix="Test.php">tests/Locator/Address</directory>
            <directory suffix="Test.php">tests/Locator/Bundle</directory>
            <directory suffix="Test.php">tests/Locator/Fixture</directory>
            <directory suffix="Test.php">tests/Locator/Infrastructure</directory>
            <directory suffix="Test.php">tests/Locator/Provider</directory>
            <directory suffix="Test.php">tests/Locator/Service</directory>
            <directory suffix="Test.php">tests/Locator/Status</directory>
            <directory suffix="Test.php">tests/Locator/Tenant</directory>
            <directory suffix="Test.php">tests/Locator/Unit</directory>
            <exclude>tests/Locator/Integration</exclude>
            <exclude>tests/Locator/Contract</exclude>
            <exclude>tests/Locator/Smoke</exclude>
        </testsuite>
        <testsuite name="locator-integration">
            <directory suffix="Test.php">tests/Locator/Integration</directory>
        </testsuite>
        <testsuite name="locator-contract">
            <directory suffix="Test.php">tests/Locator/Contract</directory>
        </testsuite>
        <testsuite name="locator-smoke">
            <directory suffix="Test.php">tests/Locator/Smoke</directory>
            <file>tests/Locator/Integration/SmokeTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">src</directory>
            <directory suffix=".php">public</directory>
            <directory suffix=".php">tools</directory>
        </include>
        <exclude>
            <directory suffix=".php">docs/legacy</directory>
        </exclude>
    </source>
</phpunit>
