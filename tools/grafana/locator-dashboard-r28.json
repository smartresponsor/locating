      "type": "stat",
      "title": "Requests per second (all ops)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(locator_request_total[1m]))",
          "legendFormat": "rps",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error rate (all ops, %)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "100 * sum(rate(locator_request_total{status=\"error\"}[5m])) / sum(rate(locator_request_total[5m]))",
          "legendFormat": "error %",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "p95 latency \u2013 suggest (ms)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(locator_request_latency_ms_bucket{operation=\"suggest\"}[5m])))",
          "legendFormat": "p95 suggest",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "p95 latency \u2013 reverse (ms)",
      "gridPos": {
        "h": 4,
        "w": 6,
