        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(locator_request_latency_ms_bucket{operation=\"reverse\"}[5m])))",
          "legendFormat": "p95 reverse",
          "refId": "A"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Request rate by operation",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum by (operation) (rate(locator_request_total[5m]))",
          "legendFormat": "{{operation}}",
